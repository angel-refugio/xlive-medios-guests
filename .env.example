# Copiar a .env y completar. Nunca subir .env a Git.

# --- Base de datos (PostgreSQL en Docker) ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=xlive
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Autenticación (Fase 2) ---
# Secreto para firmar los JWT (cadena larga y aleatoria)
JWT_SECRET=
JWT_EXPIRE_MINUTES=60
# Administrador inicial (lo usa backend/scripts/create_admin.py)
ADMIN_USERNAME=
ADMIN_PASSWORD=

# --- pgAdmin (demo al cliente) ---
PGADMIN_DEFAULT_EMAIL=
PGADMIN_DEFAULT_PASSWORD=

# --- Fases posteriores (no se usan en la Fase 1) ---
# YouTube Data API v3 (Fase 3)
YOUTUBE_API_KEY=
# Ollama local (Fase 3)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=
